# Active mode: web | enterprise
NOTEBOOKLM_MODE=web

# Web mode: profile with NotebookLM cookies and metadata
NOTEBOOKLM_PROFILE=default
NOTEBOOKLM_AUTH_DIR=~/.notebooklm-mcp-cli
NOTEBOOKLM_LANGUAGE=en

# Enterprise mode: Google Cloud NotebookLM Enterprise + Podcast API
# NOTEBOOKLM_PROJECT_NUMBER=123456789012
# NOTEBOOKLM_PROJECT_ID=my-google-cloud-project
# NOTEBOOKLM_LOCATION=global
# NOTEBOOKLM_ENDPOINT_LOCATION=global

# Enterprise auth
# NOTEBOOKLM_GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# NOTEBOOKLM_USE_GCLOUD_TOKEN=true

# Common request settings
# NOTEBOOKLM_TIMEOUT=120
# NOTEBOOKLM_MAX_RETRIES=3
